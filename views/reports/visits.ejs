<%- include('../partials/head', { wide: true }) %>
<%
  const base = { from: f.from, to: f.to, store: f.store || '', vendor: f.vendor || '', region: f.region || '', status: status || '' };
  const qs = function(o) { const p = Object.assign({}, base, o); Object.keys(p).forEach(function(k) { if (!p[k]) delete p[k]; }); return new URLSearchParams(p).toString(); };
%>
<div class="page-head">
  <div><h1>Visit log</h1><div class="sub">Every check-in and check-out, newest first<%= rows.length >= 500 ? ' (showing the latest 500; download for all)' : '' %></div></div>
  <div class="btn-row"><a class="btn" href="/reports?<%= qs({ status: '' }) %>">Reports</a><a class="btn" href="/reports/visits?<%= qs({ format: 'csv' }) %>">Download CSV</a></div>
</div>
<%- include('_filters', { action: '/reports/visits' }) %>
<section class="card flush">
<div class="table-wrap">
<table class="table compact">
<thead><tr><th>Date</th><th>Store</th><th>Vendor</th><th>Rep</th><th>Type</th><th class="num">In</th><th class="num">Out</th><th class="num">Dwell</th><th>Status</th><th>Notes</th></tr></thead>
<tbody>
<% rows.forEach(function(v) { %>
<tr>
  <td class="label"><%= fmtDate(v.d) %></td>
  <td><a href="/store/<%= v.store_id %>/visits/<%= v.id %>">#<%= v.store_number %></a> <span class="muted"><%= v.store_name %></span></td>
  <td><%= v.vendor || 'Visitor' %></td>
  <td><%= v.rep %></td>
  <td><%= VISIT_TYPES[v.visit_type] %><%= v.source === 'unscheduled' ? '' : ' · sched.' %></td>
  <td class="num"><%= v.check_in_at ? fmtTime(v.check_in_at, v.timezone) : fmtTime(v.requested_at, v.timezone) %></td>
  <td class="num"><%= fmtTime(v.check_out_at, v.timezone) %></td>
  <td class="num"><%= v.dwell_min == null ? '' : v.dwell_min + 'm' %></td>
  <td><span class="pill <%= v.status %>"><%= statusLabel(v.status) %></span></td>
  <td class="small"><%= [].concat(v.hard_failures, v.soft_failures).join('; ') %></td>
</tr>
<% }) %>
<% if (!rows.length) { %><tr><td colspan="10" class="muted">No visits match.</td></tr><% } %>
</tbody></table>
</div>
</section>
<%- include('../partials/foot') %>
