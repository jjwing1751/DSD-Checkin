<%
  const base = { from: f.from, to: f.to, store: f.store || '', vendor: f.vendor || '', region: f.region || '' };
%>
<form class="filters" method="get" action="<%= action %>">
  <% if (typeof group !== 'undefined') { %><input type="hidden" name="group" value="<%= group %>"><% } %>
  <label>From<input type="date" name="from" value="<%= f.from %>"></label>
  <label>To<input type="date" name="to" value="<%= f.to %>"></label>
  <label>Region<select name="region"><option value="">All regions</option><% regions.forEach(function(r) { %><option <%= f.region === r ? 'selected' : '' %>><%= r %></option><% }) %></select></label>
  <label>Store<select name="store"><option value="">All stores</option><% stores.forEach(function(s) { %><option value="<%= s.id %>" <%= f.store === s.id ? 'selected' : '' %>>#<%= s.store_number %> <%= s.name %></option><% }) %></select></label>
  <label>Vendor<select name="vendor"><option value="">All vendors</option><% vendors.forEach(function(v) { %><option value="<%= v.id %>" <%= f.vendor === v.id ? 'selected' : '' %>><%= v.name %></option><% }) %></select></label>
  <% if (typeof status !== 'undefined') { %>
  <label>Status<select name="status"><option value="">All</option><% ['checked_in','checked_out','auto_closed','blocked'].forEach(function(s) { %><option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= statusLabel(s) %></option><% }) %></select></label>
  <% } %>
  <button class="btn primary">Apply</button>
  <span class="spacer"></span>
  <div class="seg">
    <% const today = f.to; [['7','Last 7 days'],['30','30 days'],['90','90 days']].forEach(function(p) {
         const to = new Date().toISOString().slice(0,10);
         const from = new Date(Date.now() - (Number(p[0]) - 1) * 86400000).toISOString().slice(0,10);
         const q = new URLSearchParams(Object.assign({}, base, typeof group !== 'undefined' ? { group: group } : {}, { from: from, to: to })); %>
      <a href="<%= action %>?<%= q %>" class="<%= f.from === from && f.to === to ? 'on' : '' %>"><%= p[1] %></a>
    <% }) %>
  </div>
</form>
