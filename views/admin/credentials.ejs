<%- include('../partials/head', { wide: true }) %>
<h1>Credentials</h1>
<p class="muted">The credential list isn't decided yet, so nothing is required until you add it here. Changes apply from the next check-in.</p>
<% if (pending.length) { %>
<section class="card attention"><h2>Waiting for verification (<%= pending.length %>)</h2>
<% pending.forEach(function(p) { %>
  <div class="policy"><strong><%= p.type_name %></strong> · <%= p.person || p.company %><%= p.person && p.company ? ' (' + p.company + ')' : '' %> · <%= p.issuer || '' %> <%= p.number || '' %> · expires <%= p.expires_on || 'n/a' %>
    <% if (p.has_doc) { %> · <a href="/files/credential/<%= p.id %>" target="_blank" rel="noopener">View</a><% } %>
    <form method="post" action="/admin/credential-items/<%= p.id %>" class="inline-form"><%- include('../partials/csrf') %>
      <label>Expires<input type="date" name="expires_on" value="<%= p.expires_on || '' %>"></label>
      <button class="btn primary" name="action" value="verify">Verify</button>
      <input name="reason" placeholder="Reason if rejecting"><button class="btn danger" name="action" value="reject">Reject</button>
    </form></div>
<% }) %>
</section>
<% } %>
<% types.forEach(function(t) { %>
<details class="card <%= t.active ? '' : 'struck' %>">
  <summary><strong><%= t.name %></strong> · <%= t.holder === 'company' ? 'company' : 'person' %> · <%= t.enforcement === 'hard' ? 'blocks check-in' : 'receiver override allowed' %> · <%= t.visit_types.length ? t.visit_types.map(v => VISIT_TYPES[v]).join(', ') : 'all visit types' %> <%= t.active ? '' : '(inactive)' %></summary>
  <form method="post" action="/admin/credentials/<%= t.id %>" class="form-grid"><%- include('../partials/csrf') %><%- include('_credfields', { t: t }) %><button class="btn primary">Save</button></form>
  <form method="post" action="/admin/credentials/<%= t.id %>"><%- include('../partials/csrf') %><button class="btn" name="action" value="toggle"><%= t.active ? 'Deactivate' : 'Activate' %></button></form>
</details>
<% }) %>
<details class="card" <%= types.length ? '' : 'open' %>><summary><strong>+ Add a credential</strong></summary>
  <form method="post" action="/admin/credentials" class="form-grid"><%- include('../partials/csrf') %><%- include('_credfields', { t: {} }) %><button class="btn primary">Add</button></form>
</details>
<%- include('../partials/foot') %>
