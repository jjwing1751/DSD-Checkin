<%- include('../partials/head', { wide: true }) %>
<h1>Audit trail</h1>
<p class="muted">Append-only. Rows can't be edited; they are removed only by the retention purge.</p>
<form class="filters" method="get">
  <label>From<input type="date" name="from" value="<%= from %>"></label>
  <label>To<input type="date" name="to" value="<%= to %>"></label>
  <label>Store<select name="store"><option value="">All</option><% stores.forEach(function(s) { %><option value="<%= s.id %>" <%= storeId === s.id ? 'selected' : '' %>>#<%= s.store_number %> <%= s.name %></option><% }) %></select></label>
  <label>Record<select name="entity"><option value="">All</option><% ['visit','user','vendor_company','insurance_policy','insurance_override','insurance_requirement','credential','credential_type','service_agreement','expected_visit','store','settings'].forEach(function(e) { %><option <%= entity === e ? 'selected' : '' %>><%= e %></option><% }) %></select></label>
  <button class="btn">Show</button>
  <button class="btn" name="format" value="csv">Download CSV</button>
</form>
<section class="card scroll-x">
<table class="table compact"><thead><tr><th>When</th><th>Who</th><th>Action</th><th>Record</th><th>Store</th></tr></thead><tbody>
<% rows.forEach(function(a) { %><tr><td class="small"><%= fmtDateTime(a.at) %></td><td><%= a.actor_email || 'system' %></td><td><%= a.action %></td><td><%= a.entity %> <%= a.entity_id || '' %></td><td><%= a.store_name || '' %></td></tr><% }) %>
</tbody></table>
<% if (rows.length === 300) { %><p class="muted small">Showing the latest 300. Download the CSV for everything in range.</p><% } %>
</section>
<%- include('../partials/foot') %>
