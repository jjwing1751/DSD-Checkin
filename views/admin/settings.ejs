<%- include('../partials/head') %>
<h1>Settings</h1>
<form method="post" action="/admin/settings" class="card form-grid"><%- include('../partials/csrf') %>
  <label>Keep visit and audit records for (months)<input type="number" name="retention_months" min="1" value="<%= settings.retention_months %>"></label>
  <label>Overstay alert after expected out + (minutes)<input type="number" name="overstay_margin_min" min="0" value="<%= settings.overstay_margin_min %>"></label>
  <label>Max company insurance override (days)<input type="number" name="max_company_override_days" min="1" max="90" value="<%= settings.max_company_override_days %>"></label>
  <label class="check"><input type="checkbox" name="require_location" <%= settings.require_location ? 'checked' : '' %>> Block check-in when the phone isn't inside the store geofence (otherwise the receiver can approve)</label>
  <fieldset><legend>Service Score weights</legend>
    <label>Frequency<input type="number" name="w_frequency" value="<%= weights.frequency %>"></label>
    <label>On time<input type="number" name="w_on_time" value="<%= weights.on_time %>"></label>
    <label>Dwell<input type="number" name="w_dwell" value="<%= weights.dwell %>"></label>
    <label>Coverage<input type="number" name="w_coverage" value="<%= weights.coverage %>"></label>
  </fieldset>
  <label>Personal email domains that can't enroll (one per line)<textarea name="blocked_domains" rows="8"><%= domains.join('\n') %></textarea></label>
  <button class="btn primary">Save settings</button>
</form>
<%- include('../partials/foot') %>
