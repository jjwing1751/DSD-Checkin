<%- include('../partials/printhead') %>
<div class="poster">
  <div class="no-print btn-row"><a class="btn" href="/admin/stores/<%= s.id %>">← Back</a><button class="btn primary" data-print>Print</button></div>
  <h1>Vendors & visitors</h1>
  <h2>Check in here</h2>
  <img src="<%= qr %>" alt="Check-in QR code">
  <p class="poster-steps">1. Scan with your phone camera &nbsp; 2. Sign in with your company email &nbsp; 3. Show your pass to receiving</p>
  <p class="poster-store">#<%= s.store_number %> <%= s.name %></p>
  <p class="poster-url"><%= url %></p>
</div>
</body></html>
