<%- include('../partials/head') %>
<h1>Stores</h1>
<section class="card flush">
<table class="table">
<thead><tr><th>Store</th><th>Region</th><th class="num">In store now</th><th class="num">Check-ins today</th><th class="num">Scheduled today</th></tr></thead>
<tbody>
<% stores.forEach(function(s) { %>
<tr><td><a href="/store/<%= s.id %>">#<%= s.store_number %> <%= s.name %></a></td><td><%= s.region || '' %></td>
<td class="num"><%= s.in_store %></td><td class="num"><%= s.visits_today %></td><td class="num"><%= s.expected_today %></td></tr>
<% }) %>
</tbody></table>
<% if (!stores.length) { %><p class="muted">No stores yet.</p><% } %>
</section>
<%- include('../partials/foot') %>
