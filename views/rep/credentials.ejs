<%- include('../partials/head') %>
<h1>My credentials</h1>
<section class="card">
  <% if (!mine.length) { %><p class="muted">Nothing uploaded yet.</p><% } %>
  <ul class="list">
  <% mine.forEach(function(c) { %>
    <li class="row-between"><span><strong><%= c.name %></strong><br><span class="muted"><%= c.issuer || '' %> <%= c.number || '' %><%= c.expires_on ? ' · expires ' + fmtDate(c.expires_on) : '' %></span>
      <% if (c.reject_reason) { %><br><span class="error"><%= c.reject_reason %></span><% } %></span>
      <span class="pill <%= c.status %>"><%= statusLabel(c.status) %></span></li>
  <% }) %>
  </ul>
</section>
<% if (types.length) { %>
<section class="card narrow">
  <h2>Add a credential</h2>
  <form method="post" action="/rep/credentials" enctype="multipart/form-data" class="stack">
    <%- include('../partials/csrf') %>
    <label>Credential<select name="credential_type_id" required>
      <% types.forEach(function(t) { %><option value="<%= t.id %>"><%= t.name %><%= t.enforcement === 'hard' ? ' (required)' : '' %></option><% }) %>
    </select></label>
    <label>Issuer<input name="issuer"></label>
    <label>Number<input name="number"></label>
    <label>Issued<input type="date" name="issued_on"></label>
    <label>Expires<input type="date" name="expires_on"></label>
    <label>Document or photo<input type="file" name="doc" accept="image/*,application/pdf"></label>
    <button class="btn primary block">Submit</button>
  </form>
</section>
<% } else { %>
<p class="muted">Your stores don't require any personal credentials right now.</p>
<% } %>
<%- include('../partials/foot') %>
