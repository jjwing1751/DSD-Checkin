<%- include('../partials/head') %>
<h1><%= user.name || 'My visits' %></h1>

<% if (user.status === 'pending_identity') { %>
  <div class="flash warning">Verify your identity before your first check-in.<% if (user.identity_reject_reason) { %> Last attempt: <%= user.identity_reject_reason %><% } %> <a class="btn small" href="/rep/identity">Verify now</a></div>
<% } else if (user.status === 'identity_review') { %>
  <div class="flash info">Your ID is in review with DSD ops. You'll get an email when you can check in.</div>
<% } %>
<% if (company && company.status !== 'active') { %>
  <div class="flash warning"><%= company.name %> is <strong><%= statusLabel(company.status) %></strong>. Check-in opens once DSD ops approves your company and its insurance.</div>
<% } %>
<% if (insurance && !insurance.compliant) { %>
  <div class="flash <%= insurance.override ? 'info' : 'error' %>">
    Company insurance: <%= insurance.requirements.filter(r => !r.ok).map(r => r.coverage_type).join(', ') %> missing or expired.
    <%= insurance.override ? 'A temporary override is active until ' + fmtDateTime(insurance.override.expires_at) + '.' : 'Check-ins will be blocked. Ask your company admin to upload a current certificate.' %>
  </div>
<% } %>

<% if (openVisit) { %>
  <section class="card">
    <div class="row-between"><div><strong>Checked in</strong> at <%= openVisit.store_name %><br><span class="muted small">since <%= fmtTime(openVisit.check_in_at, openVisit.timezone) %></span></div><a class="btn small" href="/visit/<%= openVisit.id %>">Show pass</a></div>
    <form method="post" action="/visit/<%= openVisit.id %>/checkout" enctype="multipart/form-data" class="mt"><%- include('../partials/csrf') %><button class="btn primary big block">Check out</button></form>
  </section>
<% } else { %>
  <section class="card checkin-hero">
    <div class="store">Ready to check in</div>
    <p class="meta">Scan the QR poster at the store's back door with your phone camera.</p>
  </section>
<% } %>

<section class="card">
  <h2>Recent visits</h2>
  <% if (!recent.length) { %><p class="muted">None yet.</p><% } %>
  <table class="table compact"><tbody>
  <% recent.forEach(function(v) { %>
    <tr><td><%= v.store_name %><br><span class="muted small"><%= fmtDate(v.check_in_at || v.requested_at) %></span></td><td class="num small"><%= fmtTime(v.check_in_at || v.requested_at, v.timezone) %><%= v.check_out_at ? '–' + fmtTime(v.check_out_at, v.timezone) : '' %></td><td class="num"><span class="pill <%= v.status %>"><%= statusLabel(v.status) %></span></td></tr>
  <% }) %>
  </tbody></table>
</section>
<%- include('../partials/foot') %>
