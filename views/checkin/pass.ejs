<%- include('../partials/head') %>
<% const ok = v.status === 'checked_in'; %>
<% if (ok) { %>
<form method="post" action="/visit/<%= v.id %>/checkout" enctype="multipart/form-data">
  <%- include('../partials/csrf') %>
  <button class="btn primary big block">Check out</button>
  <details class="optional">
    <summary>Add work done, notes or photos (optional)</summary>
    <fieldset><legend>Work done</legend>
      <% Object.keys(WORK_TYPES).forEach(function(k) { %>
        <label class="check"><input type="checkbox" name="work" value="<%= k %>"> <%= WORK_TYPES[k] %></label>
      <% }) %>
    </fieldset>
    <label>Notes<textarea name="notes" rows="2" maxlength="1000"></textarea></label>
    <label>Shelf photos (up to 4)<input type="file" name="photos" accept="image/*" multiple></label>
    <button class="btn primary block">Check out</button>
  </details>
</form>
<% } %>

<section class="pass <%= v.status %>">
  <div class="pass-status"><%= ok ? 'CHECKED IN' : statusLabel(v.status).toUpperCase() %></div>
  <% if (user.has_selfie) { %><img class="pass-photo" src="/files/user/<%= v.user_id %>/selfie" alt="Verified photo"><% } else { %><div class="pass-photo blank">No photo on file</div><% } %>
  <h1><%= user.name %></h1>
  <p class="pass-company"><%= v.company_name || 'Visitor' %></p>
  <p class="muted"><%= v.store_name %> · <%= VISIT_TYPES[v.visit_type] %></p>
  <% if (v.check_in_at) { %><p class="pass-time">In <%= fmtTime(v.check_in_at, v.timezone) %><% if (v.check_out_at) { %> · Out <%= fmtTime(v.check_out_at, v.timezone) %><% } %></p><% } %>
</section>

<% if (v.status === 'blocked') { %>
  <section class="card attention"><p><strong>Check-in blocked.</strong> The store and DSD ops have been told.</p>
  <ul><% v.hard_failures.forEach(function(f) { %><li><%= f %></li><% }) %></ul>
  <p class="muted small">Fix the item above (or ask your company admin), then scan the poster again.</p></section>
<% } else if (ok && v.soft_failures.length) { %>
  <p class="muted small">Recorded with a note: <%= v.soft_failures.join('; ') %></p>
<% } %>
<% if (work.length) { %>
<section class="card"><h2>Work recorded</h2><ul><% work.forEach(function(w) { %><li><%= WORK_TYPES[w.type] || w.type %></li><% }) %></ul></section>
<% } %>
<div class="row-between small">
  <a href="/rep">My visits</a>
  <% if (ok) { %><form method="post" action="/visit/<%= v.id %>/cancel"><%- include('../partials/csrf') %><button class="linkish">Checked in by mistake? Undo</button></form><% } %>
</div>
<%- include('../partials/foot') %>
