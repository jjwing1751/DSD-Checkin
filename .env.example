# Copy to .env (not committed) or export these before `npm run dev`.
DATABASE_URL=postgres://postgres@localhost:5432/dsd
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=choose-a-strong-password
# PUBLIC_URL=https://dsd-checkin.onrender.com   # used in the QR posters
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=...
# MAIL_FROM="Store Check-in <checkin@yourcompany.com>"
# DEV_SHOW_CODES=true      # show sign-in codes on screen when SMTP is not configured
# JOBS_INTERVAL_MIN=15
